# Plantilla de variables de entorno (DEPLOYMENT.md §3). Copiar a .env.development
# con valores de relleno para desarrollo local — nunca commitear un .env real
# (SECURITY.md §7, DEPLOYMENT.md §4).

NODE_ENV=development
PROCESS_ROLE=api
PORT=3000

# `iot_platform_app`, NUNCA `iot_platform` (dueño de las tablas / superusuario
# de arranque de la imagen de Postgres): un superusuario o dueño se salta
# cualquier política de RLS por diseño de PostgreSQL, con o sin `ENABLE ROW
# LEVEL SECURITY" — descubierto en vivo, no era hipotético (DATA_MODEL.md §7).
# El rol se crea solo la primera vez que se inicializa el volumen de datos
# (infra/docker/postgres-init/01-app-role.sql, vía docker-entrypoint-initdb.d).
# Para migraciones/seed (`prisma migrate deploy`, `prisma db seed`), usa
# temporalmente la URL de `iot_platform` (necesita privilegios de DDL) — no
# la dejes puesta aquí para el arranque normal de la aplicación.
DATABASE_URL=postgres://iot_platform_app:dev_only_app_password@localhost:5432/iot_platform
REDIS_URL=redis://localhost:6379

# Par de claves RSA de desarrollo (SECURITY.md §8 — RS256 con kid).
# Generar uno local con:
#   openssl genrsa -out jwt-private-dev.pem 2048
#   openssl rsa -in jwt-private-dev.pem -pubout -out jwt-public-dev.pem
# y pegar el contenido aquí (o cargarlo desde archivo en el bootstrap real).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=dev-v1
ACCESS_TOKEN_TTL=15m

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_INGESTION_USERNAME=ingestion_dev
MQTT_INGESTION_PASSWORD=dev_only_password

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# Almacenamiento de objetos compatible con S3 (`StorageService`): MinIO en
# local (docker-compose.yml lo publica en el 19000), Hetzner Object Storage en
# staging/producción (infra/terraform/modules/object_storage). Guarda los
# rásters del módulo de satélite (BACKLOG.md #36); el bucket es privado y
# nunca se entrega al cliente: se firman URLs con caducidad.
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=iot-platform-dev
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key
# Hetzner nombra su región como la del servidor (`fsn1`); MinIO se traga
# cualquiera, así que en local puede omitirse.
S3_REGION=us-east-1

# Copernicus Data Space Ecosystem (módulo de satélite, BACKLOG.md #36). Se
# crea un cliente OAuth desde el panel de CDSE (User Settings) y se copia aquí;
# el secreto solo se puede copiar una vez. Nunca salen del backend: la app
# jamás habla con Copernicus directamente.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Solo para pruebas contra otro entorno; por defecto se usan las URLs oficiales
# (`CDSE_URLS` en copernicus.provider.ts).
# CDSE_TOKEN_URL=
# CDSE_BASE_URL=

# Listón de calidad de una observación: por debajo del mínimo se descarta sin
# llegar a pedir el ráster, y por encima del "bueno" se considera limpia. Entre
# los dos, se guarda marcada como parcial. Van aquí y no en el código a
# propósito: es una decisión de producto, no de programación.
SATELLITE_MIN_VALID_PIXEL_FRACTION=0.5
SATELLITE_GOOD_VALID_PIXEL_FRACTION=0.85
# Días de histórico que se traen al dar de alta una parcela. Cuidado al
# subirlo: son peticiones a Copernicus y bytes en S3 por cada parcela nueva.
SATELLITE_BACKFILL_DAYS=90

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base del frontend usada para construir enlaces en emails (invitación,
# reset de contraseña) — MembersService/AuthService/PlatformOrganizationsService.
APP_BASE_URL=http://localhost:5173

PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=change_me_locally
