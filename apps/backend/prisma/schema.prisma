// Traducción de DATA_MODEL.md a Prisma. Decisión de ORM (Etapa 13, aplazada desde
// la Etapa 5): Prisma sobre Drizzle — mejor DX/generación de tipos y comunidad más
// amplia para un equipo de 3-6 personas empezando desde cero; el control fino que
// Drizzle da sobre el SQL no compensa para este equipo, y las piezas que Prisma no
// modela de forma nativa (RLS, índices únicos parciales, el trigger de integridad
// Zona<->Gateway, el particionado de `telemetry`) se añaden en migraciones SQL
// escritas a mano (ver migrations/0002_rls_and_constraints/migration.sql) — algo
// necesario con cualquiera de los dos ORM, no es una desventaja específica de Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IAM (DATA_MODEL.md §3)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended
}

model Organization {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String             @unique
  name         String
  contactEmail String             @map("contact_email")
  status       OrganizationStatus @default(active)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  members             Member[]
  installations        Installation[]
  sessions             Session[]
  orgChannelThresholds OrgChannelThreshold[]
  organizationFeatures OrganizationFeature[]
  auditLogEntries      AuditLogEntry[]

  @@map("organizations")
}

enum UserStatus {
  active
  disabled
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  platformAdmin  PlatformAdmin?
  members        Member[]
  sessions       Session[]
  invitedMembers Member[] @relation("MemberInvitedBy")

  @@map("users")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid

  @@map("platform_admins")
}

// Etapa 5: catálogo fijo (4 filas), no un enum — permite añadir un rol futuro
// sin ALTER TYPE. Sembrado por prisma/seed.ts, nunca editable vía API en el MVP.
model Role {
  code  String @id
  label String

  members Member[]

  @@map("roles")
}

enum MemberStatus {
  invited
  active
  suspended
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleCode       String       @map("role_code")
  status         MemberStatus @default(invited)
  invitedById    String?      @map("invited_by") @db.Uuid
  invitedAt      DateTime?    @map("invited_at")
  activatedAt    DateTime?    @map("activated_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  user             User                     @relation(fields: [userId], references: [id])
  organization     Organization             @relation(fields: [organizationId], references: [id])
  role             Role                     @relation(fields: [roleCode], references: [code])
  invitedBy        User?                    @relation("MemberInvitedBy", fields: [invitedById], references: [id])
  installationScope MemberInstallationScope[]

  @@unique([userId, organizationId]) // Etapa 5 §3: un único rol por organización
  @@index([organizationId])
  @@map("members")
}

model MemberInstallationScope {
  memberId       String   @map("member_id") @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  member       Member       @relation(fields: [memberId], references: [id])
  installation Installation @relation(fields: [installationId], references: [id])

  @@id([memberId, installationId])
  @@map("member_installation_scope")
}

model Session {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  organizationId     String?      @map("organization_id") @db.Uuid
  refreshSecretHash  String       @map("refresh_secret_hash")
  userAgent          String?      @map("user_agent")
  ipAddress          String?      @map("ip_address")
  createdAt          DateTime     @default(now()) @map("created_at")
  lastUsedAt         DateTime     @default(now()) @map("last_used_at")
  expiresAt          DateTime     @map("expires_at")
  revokedAt          DateTime?    @map("revoked_at")

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Directorio IoT (DATA_MODEL.md §4) — esqueleto de modelo para que Member/
// Session compilen ya; el módulo de negocio se implementa en el siguiente
// paso de la Etapa 13 (ver PROJECT_STATUS.md).
// ---------------------------------------------------------------------------

enum InstallationStatus {
  active
  inactive
}

model Installation {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name         String
  locationText String?            @map("location_text")
  latitude     Float?
  longitude    Float?
  status       InstallationStatus @default(active)
  /// Datos de la explotacion para el cuaderno completo (migracion 0010).
  /// Opcionales: una campaña sencilla no los necesita.
  holderName   String?            @map("holder_name")
  holderNif    String?            @map("holder_nif")
  /// Codigo de la explotacion en el REA.
  reaCode      String?            @map("rea_code")
  address      String?
  /// ISO 3166-2 de la comunidad autonoma (`ES-AN`): zonas vulnerables y
  /// extensiones autonomicas del cuaderno (ADR-0014).
  regionCode   String?            @map("region_code")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  organization      Organization              @relation(fields: [organizationId], references: [id])
  zones             Zone[]
  gateways          Gateway[]
  parcels           Parcel[]
  memberScopes      MemberInstallationScope[]
  campaigns         Campaign[]

  @@index([organizationId])
  @@map("installations")
}

/// Recinto de cultivo dibujado por el usuario sobre un mapa, dentro de una
/// finca (BACKLOG.md #36). Es la unidad del modulo de satelite: las
/// observaciones de Sentinel-2 se calculan sobre su contorno real, no sobre el
/// punto GPS de la finca.
///
/// La geometria la guarda PostGIS (`geometry(MultiPolygon, 4326)`). Prisma 5
/// no modela tipos geometricos, asi que la columna va como `Unsupported`: eso
/// significa que **`prisma.parcel.create()` no es utilizable** y que
/// `findMany` no devuelve la geometria. Las dos operaciones que la necesitan
/// (crear y leer el contorno) viven en `ParcelsRepository` con SQL crudo
/// dentro de `runInTenantContext`; el resto de columnas se manejan con Prisma
/// con normalidad. Se guarda MultiPolygon aunque la v1 solo deje dibujar un
/// recinto: una parcela partida por un camino es corriente, y admitirlo hoy
/// no cuesta nada.
model Parcel {
  id              String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                              @map("organization_id") @db.Uuid
  installationId  String                              @map("installation_id") @db.Uuid
  name            String
  geometry        Unsupported("geometry(MultiPolygon, 4326)")
  areaM2          Float                               @map("area_m2")
  bboxMinLon      Float                               @map("bbox_min_lon")
  bboxMinLat      Float                               @map("bbox_min_lat")
  bboxMaxLon      Float                               @map("bbox_max_lon")
  bboxMaxLat      Float                               @map("bbox_max_lat")
  /// Sube cada vez que cambia el contorno: invalida lo calculado antes sobre
  /// la geometria anterior.
  geometryVersion Int                                 @default(1) @map("geometry_version")
  notes           String?
  createdAt       DateTime                            @default(now()) @map("created_at")
  updatedAt       DateTime                            @updatedAt @map("updated_at")
  deletedAt       DateTime?                           @map("deleted_at")

  installation Installation           @relation(fields: [installationId], references: [id])
  gateways     Gateway[]
  observations SatelliteObservation[]
  cropUnits    CropUnitParcel[]

  @@index([organizationId])
  @@index([installationId])
  @@map("parcels")
  // Indice espacial GiST sobre `geometry` -> migracion SQL manual (0008).
}

model Zone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installationId String    @map("installation_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  zoneType       String?   @map("zone_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  installation Installation @relation(fields: [installationId], references: [id])
  devices      Device[]

  @@index([installationId])
  @@index([organizationId])
  @@map("zones")
}

enum ConnectivityType {
  lora_concentrator
  direct_nbiot
  direct_other
}

enum GatewayStatus {
  not_provisioned
  online
  offline
  disabled
}

model Gateway {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid
  installationId           String           @map("installation_id") @db.Uuid
  externalIdentifier       String           @unique @map("external_identifier")
  name                     String
  /// Parcela a la que riega/vigila esta estacion, si se le ha asignado una
  /// (BACKLOG.md #36). Opcional a proposito: las estaciones existentes siguen
  /// funcionando sin parcela, y una parcela puede no tener ninguna. Un trigger
  /// (migracion 0008) exige que la parcela sea de la misma organizacion y la
  /// misma instalacion que el gateway.
  parcelId                 String?          @map("parcel_id") @db.Uuid
  connectivityType         ConnectivityType @map("connectivity_type")
  status                   GatewayStatus    @default(not_provisioned)
  lastSeenAt               DateTime?        @map("last_seen_at")
  heartbeatIntervalSeconds Int?             @map("heartbeat_interval_seconds")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  deletedAt                DateTime?        @map("deleted_at")

  installation Installation        @relation(fields: [installationId], references: [id])
  parcel       Parcel?             @relation(fields: [parcelId], references: [id])
  credentials  GatewayCredential[]
  devices      Device[]
  alerts       Alert[]

  @@index([organizationId])
  @@index([installationId])
  @@index([parcelId])
  @@map("gateways")
}

enum CredentialStatus {
  active
  revoked
}

model GatewayCredential {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatewayId  String            @map("gateway_id") @db.Uuid
  secretHash String            @map("secret_hash")
  status     CredentialStatus  @default(active)
  createdAt  DateTime          @default(now()) @map("created_at")
  revokedAt  DateTime?         @map("revoked_at")

  gateway Gateway @relation(fields: [gatewayId], references: [id])

  @@map("gateway_credentials")
  // Índice único parcial (gateway_id) WHERE status='active' -> migración SQL manual
}

model Device {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  gatewayId          String        @map("gateway_id") @db.Uuid
  zoneId             String        @map("zone_id") @db.Uuid
  externalIdentifier String        @map("external_identifier")
  name               String
  status             GatewayStatus @default(not_provisioned)
  lastSeenAt         DateTime?     @map("last_seen_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  gateway Gateway  @relation(fields: [gatewayId], references: [id])
  zone    Zone     @relation(fields: [zoneId], references: [id])
  sensors Sensor[]
  alerts  Alert[]

  @@unique([gatewayId, externalIdentifier])
  @@index([organizationId])
  @@index([zoneId])
  @@map("devices")
}

model Sensor {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  deviceId           String    @map("device_id") @db.Uuid
  externalIdentifier String    @map("external_identifier")
  label              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  device   Device    @relation(fields: [deviceId], references: [id])
  channels Channel[]

  @@unique([deviceId, externalIdentifier])
  @@map("sensors")
}

enum ChannelDataType {
  continuous
  boolean
  counter
}

enum ChannelAggregation {
  average
  sum
  count_true
}

model ChannelType {
  code                String             @id
  unit                String
  dataType            ChannelDataType    @map("data_type")
  defaultAggregation  ChannelAggregation @map("default_aggregation")
  minValid            Float?             @map("min_valid")
  maxValid            Float?             @map("max_valid")

  channels             Channel[]
  orgChannelThresholds OrgChannelThreshold[]

  @@map("channel_types")
}

model Channel {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  sensorId           String    @map("sensor_id") @db.Uuid
  channelTypeCode    String    @map("channel_type_code")
  alertThresholdMin  Float?    @map("alert_threshold_min")
  alertThresholdMax  Float?    @map("alert_threshold_max")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  sensor      Sensor      @relation(fields: [sensorId], references: [id])
  channelType ChannelType @relation(fields: [channelTypeCode], references: [code])
  telemetryEntries Telemetry[]
  latestReading    LatestReading?
  alerts           Alert[]

  @@unique([sensorId, channelTypeCode])
  @@map("channels")
}

model OrgChannelThreshold {
  organizationId  String   @map("organization_id") @db.Uuid
  channelTypeCode String   @map("channel_type_code")
  defaultMin      Float?   @map("default_min")
  defaultMax      Float?   @map("default_max")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  channelType  ChannelType  @relation(fields: [channelTypeCode], references: [code])

  @@id([organizationId, channelTypeCode])
  @@map("org_channel_thresholds")
}

// ---------------------------------------------------------------------------
// Feature flags por organización (Etapa 4/13, PERMISSIONS.md §14)
// ---------------------------------------------------------------------------

model Feature {
  code  String @id
  label String

  organizationFeatures OrganizationFeature[]

  @@map("features")
}

model OrganizationFeature {
  organizationId String   @map("organization_id") @db.Uuid
  featureCode    String   @map("feature_code")
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  feature      Feature      @relation(fields: [featureCode], references: [code])

  @@id([organizationId, featureCode])
  @@map("organization_features")
}

// ---------------------------------------------------------------------------
// Auditoría (DATA_MODEL.md §6) — inmutable, bigint identity (§6, justificado ahí)
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Telemetría y alertas (DATA_MODEL.md §5). La tabla física `telemetry` está
// particionada por rango de `ts_origin` — Prisma no expresa `PARTITION BY`
// de forma nativa, así que (igual que RLS en migration 0002) la migración
// 0003 la crea a mano en vez de dejar que Prisma genere un CREATE TABLE
// plano; el modelo de aquí abajo describe exactamente las mismas columnas
// para que el cliente Prisma tenga los tipos correctos.
// ---------------------------------------------------------------------------

model Telemetry {
  channelId      String   @map("channel_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tsOrigin       DateTime @map("ts_origin")
  tsReceived     DateTime @default(now()) @map("ts_received")
  value          Float
  messageId      String?  @map("message_id")

  channel Channel @relation(fields: [channelId], references: [id])

  @@id([channelId, tsOrigin]) // Clave de deduplicación (MQTT_PROTOCOL.md §5), no un `id` superficial (DATA_MODEL.md §5)
  @@map("telemetry")
}

model LatestReading {
  channelId      String   @id @map("channel_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  value          Float
  tsOrigin       DateTime @map("ts_origin")
  tsReceived     DateTime @map("ts_received")
  updatedAt      DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id])

  @@map("latest_readings")
}

enum AlertType {
  threshold
  offline
  /// La estacion envia pero sus sensores no dan datos (BACKLOG.md #57).
  no_sensor_data
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

model Alert {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  alertType        AlertType   @map("alert_type")
  channelId        String?     @map("channel_id") @db.Uuid
  deviceId         String?     @map("device_id") @db.Uuid
  gatewayId        String?     @map("gateway_id") @db.Uuid
  status           AlertStatus @default(open)
  openedAt         DateTime    @map("opened_at")
  acknowledgedAt   DateTime?   @map("acknowledged_at")
  acknowledgedById String?     @map("acknowledged_by") @db.Uuid
  resolvedAt       DateTime?   @map("resolved_at")
  resolvedById     String?     @map("resolved_by") @db.Uuid
  details          Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  channel       Channel?          @relation(fields: [channelId], references: [id])
  device        Device?           @relation(fields: [deviceId], references: [id])
  gateway       Gateway?          @relation(fields: [gatewayId], references: [id])
  notifications NotificationLog[]

  @@index([organizationId, status])
  @@map("alerts")
  // Índices únicos parciales "una alerta abierta por causa" -> migración SQL manual (DATA_MODEL.md §5)
}

enum NotificationChannel {
  email
}

enum NotificationStatus {
  sent
  failed
}

model NotificationLog {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  alertId         String              @map("alert_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel @default(email)
  status          NotificationStatus
  sentAt          DateTime            @map("sent_at")
  error           String?

  alert Alert @relation(fields: [alertId], references: [id])

  @@unique([alertId, recipientUserId]) // Evita reenviar la misma notificación dos veces (DATA_MODEL.md §5)
  @@map("notification_log")
}

// ---------------------------------------------------------------------------
// Satelite (BACKLOG.md #36). Dominio propio, NO canales de telemetria: un
// Channel cuelga de un Sensor, que es hardware, y una observacion de satelite
// no tiene sensor detras. Mezclarlos habria obligado a inventar un sensor
// falso por parcela.
//
// Las tablas se crean a mano en la migracion 0009 (RLS, CHECKs e indices
// unicos parciales), igual que el resto del esquema.
// ---------------------------------------------------------------------------

enum SatelliteObservationStatus {
  pending
  processing
  ready
  /// Habia imagen, pero demasiado tapada para medir nada (ver qualityStatus).
  rejected_quality
  failed
}

enum SatelliteQualityStatus {
  good
  partial
  rejected
}

/// Una pasada del satelite sobre una parcela, ya procesada.
///
/// La clave logica es (parcela, proveedor, coleccion, dia, version de
/// procesado): una parcela a caballo de dos tiles produce varios items STAC de
/// la MISMA pasada, y para nosotros es una sola observacion. Por eso
/// `sourceItemIds` es una lista y no hay ningun `scene_id`.
model SatelliteObservation {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                     @map("organization_id") @db.Uuid
  parcelId             String                     @map("parcel_id") @db.Uuid
  /// `copernicus` hoy; texto y no enum para que anadir un proveedor no sea un ALTER TYPE.
  provider             String
  collection           String
  /// Momento de la pasada, en UTC. Es la fecha de las graficas, nunca `processedAt`.
  acquisitionTime      DateTime                   @map("acquisition_time")
  /// El dia UTC de la pasada: la parte de la clave logica.
  acquisitionDate      DateTime                   @map("acquisition_date") @db.Date
  /// Items STAC que cubrieron el recinto en esa pasada.
  sourceItemIds        Json                       @map("source_item_ids")
  platform             String?
  /// Version del algoritmo/evalscript (`ndvi-s2-v1`): permite reprocesar sin pisar.
  processingVersion    String                     @map("processing_version")
  /// Contorno sobre el que se calculo: si la parcela se redibuja, esto queda viejo.
  parcelGeometryVersion Int                       @map("parcel_geometry_version")
  /// 0..1. El numero que decide si la observacion sirve.
  validPixelFraction   Float?                     @map("valid_pixel_fraction")
  /// 0..1 dentro de la parcela. Null en la v1 (ver BACKLOG.md #36).
  parcelCloudFraction  Float?                     @map("parcel_cloud_fraction")
  /// 0..1 de la escena entera, informativo: no es la nubosidad de la parcela.
  sceneCloudCover      Float?                     @map("scene_cloud_cover")
  qualityStatus        SatelliteQualityStatus?    @map("quality_status")
  status               SatelliteObservationStatus @default(pending)
  /// Motivo del ultimo fallo, sin secretos: se ensena en la ficha de la parcela.
  lastError            String?                    @map("last_error")
  processedAt          DateTime?                  @map("processed_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  parcel  Parcel             @relation(fields: [parcelId], references: [id])
  metrics SatelliteMetric[]
  assets  SatelliteAsset[]

  /// La clave logica de una observacion. `name` para poder nombrarla asi desde
  /// el cliente; `map` para que el indice de la base se llame como en la
  /// migracion 0009.
  @@unique([parcelId, provider, collection, acquisitionDate, processingVersion], name: "claveLogica", map: "satellite_observations_logica_uniq")
  @@index([organizationId])
  @@index([parcelId, acquisitionTime])
  @@map("satellite_observations")
}

/// Estadisticas de un indice sobre los pixeles validos de la parcela. Una fila
/// por indice: anadir NDRE o NDMI manana es una fila mas, no una columna mas.
model SatelliteMetric {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  observationId  String   @map("observation_id") @db.Uuid
  /// `ndvi` en la v1.
  metricCode     String   @map("metric_code")
  mean           Float
  median         Float
  min            Float
  max            Float
  stdDev         Float    @map("std_dev")
  p10            Float
  p90            Float
  sampleCount    Int      @map("sample_count")
  noDataCount    Int      @map("no_data_count")
  createdAt      DateTime @default(now()) @map("created_at")

  observation SatelliteObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, metricCode])
  @@index([organizationId])
  @@map("satellite_metrics")
}

/// Archivo guardado en el almacenamiento de objetos. La fila dice donde esta;
/// el objeto solo sale firmado y con caducidad (`StorageService`).
model SatelliteAsset {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  observationId  String   @map("observation_id") @db.Uuid
  /// `ndvi_raster` (GeoTIFF FLOAT32, el dato) o `ndvi_preview` (PNG, solo pintar).
  assetType      String   @map("asset_type")
  objectKey      String   @map("object_key")
  mediaType      String   @map("media_type")
  width          Int?
  height         Int?
  bboxMinLon     Float    @map("bbox_min_lon")
  bboxMinLat     Float    @map("bbox_min_lat")
  bboxMaxLon     Float    @map("bbox_max_lon")
  bboxMaxLat     Float    @map("bbox_max_lat")
  crs            String
  /// Valor de "sin dato" del raster (NaN en FLOAT32); null en el PNG.
  nodata         Float?
  byteSize       Int      @map("byte_size")
  checksum       String?
  createdAt      DateTime @default(now()) @map("created_at")

  observation SatelliteObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, assetType])
  @@index([organizationId])
  @@map("satellite_assets")
}

// ---------------------------------------------------------------------------
// Campañas y cuaderno de campo (BACKLOG.md #60, ADR-0012/0013/0014).
// Migraciones 0010-0012, escritas a mano: RLS, CHECKs, triggers e indices
// parciales viven alli, no aqui.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  active
  closed
  archived
}

/// Cambia la experiencia y las validaciones, no la estructura (ADR-0013):
/// pasar de sencilla a completa no copia ni borra nada.
enum CampaignManagementMode {
  simple
  complete
}

/// Catalogo global de cultivos (sin organizacion, sin RLS). Codigos oficiales
/// vacios hasta importar los catalogos (EPPO, SIEX): nunca a ojo.
model Crop {
  /// Slug estable: `aguacate`.
  id                 String   @id
  name               String
  /// woody | herbaceous | horticultural | forage | other
  category           String
  eppoCode           String?  @map("eppo_code")
  siexCode           String?  @map("siex_code")
  siexCatalogVersion String?  @map("siex_catalog_version")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cropUnits CropUnit[]

  @@map("crops")
}

/// Periodo productivo de una finca ("Aguacate Hass · 2026").
model Campaign {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  installationId       String                 @map("installation_id") @db.Uuid
  name                 String
  status               CampaignStatus         @default(active)
  managementMode       CampaignManagementMode @default(simple) @map("management_mode")
  /// Fechas sin hora: una campaña empieza "el 3 de febrero".
  startDate            DateTime               @map("start_date") @db.Date
  expectedEndDate      DateTime?              @map("expected_end_date") @db.Date
  endDate              DateTime?              @map("end_date") @db.Date
  notes                String?
  /// Respuestas del asistente del cuaderno completo. Configuracion, no datos
  /// regulados: JSON validado en la aplicacion.
  notebookProfile      Json                   @default("{}") @map("notebook_profile")
  declaredProductionKg Float?                 @map("declared_production_kg")
  closingNotes         String?                @map("closing_notes")
  closedAt             DateTime?              @map("closed_at")
  closedBy             String?                @map("closed_by") @db.Uuid
  createdBy            String                 @map("created_by") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  deletedAt            DateTime?              @map("deleted_at")

  installation  Installation       @relation(fields: [installationId], references: [id])
  cropUnits     CropUnit[]
  activities    CampaignActivity[]
  snapshots     CampaignSnapshot[]
  documentLinks DocumentLink[]

  @@index([organizationId])
  @@index([installationId])
  @@map("campaigns")
}

/// Unidad de cultivo: mismo cultivo y manejo sobre una o varias parcelas.
model CropUnit {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  campaignId         String    @map("campaign_id") @db.Uuid
  cropId             String?   @map("crop_id")
  /// El nombre tal como se eligio: no cambia si se renombra el catalogo.
  cropName           String    @map("crop_name")
  variety            String?
  previousCrop       String?   @map("previous_crop")
  /// rainfed | irrigated
  waterRegime        String?   @map("water_regime")
  /// open_field | greenhouse | other
  growingEnvironment String?   @map("growing_environment")
  /// conventional | integrated | organic
  productionSystem   String?   @map("production_system")
  /// Superficie cultivada declarada; si es nula, la suma de sus parcelas.
  areaHa             Float?    @map("area_ha")
  expectedYieldKgHa  Float?    @map("expected_yield_kg_ha")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  campaign Campaign         @relation(fields: [campaignId], references: [id])
  crop     Crop?            @relation(fields: [cropId], references: [id])
  parcels  CropUnitParcel[]

  @@index([organizationId])
  @@index([campaignId])
  @@map("crop_units")
}

/// Que parcelas ocupa una unidad, y cuanto de cada una (nulo = entera).
model CropUnitParcel {
  cropUnitId     String   @map("crop_unit_id") @db.Uuid
  parcelId       String   @map("parcel_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  areaHa         Float?   @map("area_ha")
  createdAt      DateTime @default(now()) @map("created_at")

  cropUnit CropUnit         @relation(fields: [cropUnitId], references: [id])
  parcel   Parcel           @relation(fields: [parcelId], references: [id])
  targets  ActivityTarget[]

  @@id([cropUnitId, parcelId])
  @@index([organizationId])
  @@index([parcelId])
  @@map("crop_unit_parcels")
}

/// Lo que se ha hecho en la campaña. Fecha de inicio y de fin siempre, como
/// en el CUE: un riego de un dia las tiene iguales.
model CampaignActivity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  /// irrigation | fertilization | phytosanitary | field_work | harvest |
  /// observation | sowing | other (CHECK en la migracion 0011)
  type           String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /// `HH:mm`, hora local de la finca. Solo tiene sentido en tratamientos.
  startTime      String?   @map("start_time")
  notes          String?
  /// manual | repeated | sensor_suggestion
  origin         String    @default("manual")
  repeatedFromId String?   @map("repeated_from_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")

  campaign              Campaign               @relation(fields: [campaignId], references: [id])
  repeatedFrom          CampaignActivity?      @relation("Repeticion", fields: [repeatedFromId], references: [id])
  repetitions           CampaignActivity[]     @relation("Repeticion")
  targets               ActivityTarget[]
  irrigation            IrrigationDetail?
  fertilization         FertilizationDetail?
  phytosanitary         PhytosanitaryDetail?
  phytosanitaryProducts PhytosanitaryProduct[]
  harvest               HarvestDetail?
  fieldWork             FieldWorkDetail?
  documentLinks         DocumentLink[]

  @@index([organizationId])
  @@map("campaign_activities")
}

/// Sobre que parcela (de que unidad) se hizo una actividad, y cuanta superficie.
model ActivityTarget {
  activityId     String @map("activity_id") @db.Uuid
  cropUnitId     String @map("crop_unit_id") @db.Uuid
  parcelId       String @map("parcel_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Nulo = toda la superficie de esa parcela en la unidad.
  areaHa         Float? @map("area_ha")

  activity       CampaignActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  cropUnitParcel CropUnitParcel   @relation(fields: [cropUnitId, parcelId], references: [cropUnitId, parcelId])

  @@id([activityId, cropUnitId, parcelId])
  @@index([organizationId])
  @@index([parcelId])
  @@map("activity_targets")
}

/// Riego (CUE bloque 10).
model IrrigationDetail {
  activityId     String  @id @map("activity_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  system         String?
  /// Lo que escribio el usuario: valor + unidad (m3 | m3_ha | l).
  amount         Float?
  amountUnit     String? @map("amount_unit")
  /// Normalizado por el backend: m3 totales.
  volumeM3       Float?  @map("volume_m3")
  waterSource    String? @map("water_source")
  meterNumber    String? @map("meter_number")
  nitrateMgL     Float?  @map("nitrate_mg_l")
  p2o5MgL        Float?  @map("p2o5_mg_l")

  activity CampaignActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("irrigation_details")
}

/// Fertilizacion (CUE bloque 9, RD 1051/2022 art. 5).
model FertilizationDetail {
  activityId        String  @id @map("activity_id") @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  fertilizationType String? @map("fertilization_type")
  materialType      String? @map("material_type")
  productName       String? @map("product_name")
  dose              Float?
  doseUnit          String? @map("dose_unit")
  applicationMethod String? @map("application_method")
  nPct              Float?  @map("n_pct")
  p2o5Pct           Float?  @map("p2o5_pct")
  k2oPct            Float?  @map("k2o_pct")
  organicMatterPct  Float?  @map("organic_matter_pct")
  /// Normalizados por el backend, solo cuando las unidades lo permiten.
  nKgHa             Float?  @map("n_kg_ha")
  p2o5KgHa          Float?  @map("p2o5_kg_ha")
  k2oKgHa           Float?  @map("k2o_kg_ha")
  supplierName      String? @map("supplier_name")
  supplierNif       String? @map("supplier_nif")
  supplierRega      String? @map("supplier_rega")
  supplierNima      String? @map("supplier_nima")
  applicatorCompany String? @map("applicator_company")
  regferCode        String? @map("regfer_code")
  equipmentId       String? @map("equipment_id") @db.Uuid
  /// Copia del equipo al registrar: el cuaderno de hoy no cambia si cambia su ficha.
  equipmentSnapshot Json?   @map("equipment_snapshot")

  activity  CampaignActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  equipment NotebookEquipment? @relation(fields: [equipmentId], references: [id])

  @@map("fertilization_details")
}

/// Tratamiento fitosanitario (CUE bloque 8, Reglamento (UE) 2023/564).
model PhytosanitaryDetail {
  activityId             String   @id @map("activity_id") @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  problem                String?
  /// weeds | diseases | arthropods | growth_regulators | other
  problemCategory        String?  @map("problem_category")
  justification          String?
  /// Codigo BBCH por dentro; el nombre que vio el agricultor, al lado.
  bbchCode               String?  @map("bbch_code")
  phenologicalStageLabel String?  @map("phenological_stage_label")
  applicatorId           String?  @map("applicator_id") @db.Uuid
  applicatorSnapshot     Json?    @map("applicator_snapshot")
  adviserId              String?  @map("adviser_id") @db.Uuid
  adviserSnapshot        Json?    @map("adviser_snapshot")
  equipmentId            String?  @map("equipment_id") @db.Uuid
  equipmentSnapshot      Json?    @map("equipment_snapshot")
  manualApplication      Boolean? @map("manual_application")
  /// good | fair | poor
  efficacy               String?

  activity   CampaignActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  applicator NotebookPerson?    @relation("Aplicador", fields: [applicatorId], references: [id])
  adviser    NotebookPerson?    @relation("Asesor", fields: [adviserId], references: [id])
  equipment  NotebookEquipment? @relation(fields: [equipmentId], references: [id])

  @@map("phytosanitary_details")
}

/// Un producto de un tratamiento (puede ser una mezcla de varios).
model PhytosanitaryProduct {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  activityId        String    @map("activity_id") @db.Uuid
  position          Int       @default(0) @db.SmallInt
  productName       String    @map("product_name")
  registryNumber    String?   @map("registry_number")
  activeSubstances  String?   @map("active_substances")
  dose              Float?
  /// l_ha | kg_ha | l_hl | kg_hl
  doseUnit          String?   @map("dose_unit")
  totalQuantity     Float?    @map("total_quantity")
  /// l | kg
  totalQuantityUnit String?   @map("total_quantity_unit")
  /// manual | mapa_registry
  source            String    @default("manual")
  sourceUpdatedAt   DateTime? @map("source_updated_at")

  activity CampaignActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([organizationId])
  @@map("phytosanitary_products")
}

/// Cosecha, recoleccion o siega (CUE bloque 11).
model HarvestDetail {
  activityId      String  @id @map("activity_id") @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  product         String?
  quantity        Float?
  /// kg | t | units
  quantityUnit    String? @map("quantity_unit")
  /// En kg, para sumar y sacar el rendimiento. Nulo si se conto en unidades.
  quantityKg      Float?  @map("quantity_kg")
  lotCode         String? @map("lot_code")
  deliveryNote    String? @map("delivery_note")
  customerName    String? @map("customer_name")
  customerNif     String? @map("customer_nif")
  customerAddress String? @map("customer_address")
  customerRgseaa  String? @map("customer_rgseaa")
  destination     String?
  qualityGrade    String? @map("quality_grade")

  activity CampaignActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("harvest_details")
}

/// Labores (CUE bloque 5).
model FieldWorkDetail {
  activityId           String   @id @map("activity_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  workType             String   @map("work_type")
  pruningResiduesLeft  Boolean? @map("pruning_residues_left")
  clearingResiduesLeft Boolean? @map("clearing_residues_left")
  hours                Float?
  machinery            String?

  activity CampaignActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("field_work_details")
}

/// Aplicadores, empresas de servicios y asesores: se dan de alta una vez.
model NotebookPerson {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Nulo = sirve para todas las fincas de la organizacion.
  installationId String?   @map("installation_id") @db.Uuid
  /// own_staff | service_company | adviser
  kind           String
  firstName      String?   @map("first_name")
  surname1       String?   @map("surname_1")
  surname2       String?   @map("surname_2")
  companyName    String?   @map("company_name")
  nif            String?
  ropoNumber     String?   @map("ropo_number")
  ropoCardType   String?   @map("ropo_card_type")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  treatmentsAsApplicator PhytosanitaryDetail[] @relation("Aplicador")
  treatmentsAsAdviser    PhytosanitaryDetail[] @relation("Asesor")
  documentLinks          DocumentLink[]

  @@index([organizationId])
  @@map("notebook_people")
}

/// Equipos de tratamiento y aplicacion.
model NotebookEquipment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  installationId   String?   @map("installation_id") @db.Uuid
  description      String
  brand            String?
  model            String?
  /// Inscripcion en el ROMA (o REGANIP).
  romaNumber       String?   @map("roma_number")
  acquiredOn       DateTime? @map("acquired_on") @db.Date
  lastInspectionOn DateTime? @map("last_inspection_on") @db.Date
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  phytosanitaryDetails PhytosanitaryDetail[]
  fertilizationDetails FertilizationDetail[]
  documentLinks        DocumentLink[]

  @@index([organizationId])
  @@map("notebook_equipment")
}

/// Un fichero en el almacenamiento de objetos, guardado una sola vez por
/// organizacion (indice unico parcial sobre el SHA-256).
model Document {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  installationId String?   @map("installation_id") @db.Uuid
  documentType   String    @map("document_type")
  title          String?
  filename       String
  mediaType      String    @map("media_type")
  byteSize       Int       @map("byte_size")
  /// SHA-256 en hexadecimal.
  checksum       String
  objectKey      String    @unique @map("object_key")
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Uuid

  links DocumentLink[]

  @@index([organizationId])
  @@map("documents")
}

/// Donde se usa un documento: exactamente uno de los cuatro destinos.
model DocumentLink {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  campaignId     String?  @map("campaign_id") @db.Uuid
  activityId     String?  @map("activity_id") @db.Uuid
  equipmentId    String?  @map("equipment_id") @db.Uuid
  personId       String?  @map("person_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  document  Document           @relation(fields: [documentId], references: [id])
  campaign  Campaign?          @relation(fields: [campaignId], references: [id])
  activity  CampaignActivity?  @relation(fields: [activityId], references: [id])
  equipment NotebookEquipment? @relation(fields: [equipmentId], references: [id])
  person    NotebookPerson?    @relation(fields: [personId], references: [id])

  @@index([organizationId])
  @@index([documentId])
  @@map("document_links")
}

/// Como era todo al cerrar la campaña. Inmutable (trigger en la migracion 0012).
model CampaignSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  /// `close`
  reason         String
  content        Json
  contentVersion Int      @default(1) @map("content_version")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([campaignId])
  @@map("campaign_snapshots")
}
