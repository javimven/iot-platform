# Estado de Terraform — contiene valores en texto plano (incluidos los
# marcados `sensitive`, que solo se ocultan en la salida de la CLI, no en el
# fichero de estado) — nunca se versiona.
*.tfstate
*.tfstate.*
.terraform.lock.hcl.bak

# Valores reales por entorno/secretos.
terraform.tfvars
*.auto.tfvars

# Tokens de proveedor para cargar con `source` (Bash) o `. .\secrets.ps1`
# (PowerShell) antes de terraform init/plan/apply (HCLOUD_TOKEN,
# DIGITALOCEAN_TOKEN, CLOUDFLARE_EMAIL/API_KEY/API_TOKEN) — nunca se
# versiona, nunca se pega en el chat.
secrets.env
secrets.ps1

# Caché de providers descargados.
.terraform/

# Planes guardados (pueden contener secretos en claro).
*.tfplan
crash.log
crash.*.log
