# Plantilla del .env del puente de la estación WSC2-N
# (docker-compose.puente.yml, BACKLOG.md #44). Copiar a
# /opt/iot-platform/puente/.env en la VPS — nunca al repositorio.

# SHA del commit de javimven/rs485-tool cuya imagen se despliega.
PUENTE_TAG=

# Solo se aceptan los envíos de esta estación: el puerto UDP está abierto a
# cualquier IP.
STATION_IMEI=

# iot-platform, por la red interna de Docker (sin TLS y sin exponer el 1883).
PLATFORM_MQTT_URL=mqtt://emqx:1883
PLATFORM_ORG_ID=
PLATFORM_GATEWAY_ID=
PLATFORM_DEVICE_ID=

# ThingsBoard (opcional: sin estas dos, solo entrega a la plataforma).
TB_URL=
TB_TOKEN=
