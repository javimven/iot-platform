# Plantilla de variables de entorno para docker-compose.deploy.yml
# (staging/producción, DEPLOYMENT.md §3/§4). Copiar a `.env` **en la VPS**,
# nunca en este repositorio — en CI/CD vive como secretos de GitHub Actions
# Environments (`staging`/`production`) y el pipeline de despliegue lo
# escribe en la VPS en el momento de desplegar, no antes.
#
# Mismas variables que apps/backend/.env.example (Etapa 13) — este archivo
# solo añade las que son propias del entorno de despliegue (Grafana Cloud,
# dominio) y omite las que ya no aplican (no hay Postgres/MinIO en
# contenedor aquí, son servicios gestionados aprovisionados por
# infra/terraform/).

NODE_ENV=production

# DigitalOcean Managed Postgres — infra/terraform/modules/database, output
# `connection_string` (usuario restringido `iot_platform_app`, sin
# BYPASSRLS — ver comentario en el propio módulo sobre el paso de
# migración que todavía hace falta para crear ese rol).
DATABASE_URL=postgres://iot_platform_app:CHANGEME@CHANGEME.db.ondigitalocean.com:25060/iot_platform?sslmode=require

REDIS_URL=redis://redis:6379

# Par de claves RSA reales (SECURITY.md §8) — NUNCA reutilizar el par de
# desarrollo. Generar con openssl igual que en apps/backend/.env.example,
# guardar el contenido completo (con los \n literales) como secreto.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=prod-v1
ACCESS_TOKEN_TTL=15m

MQTT_BROKER_URL=mqtt://emqx:1883
MQTT_INGESTION_USERNAME=CHANGEME
MQTT_INGESTION_PASSWORD=CHANGEME

SMTP_HOST=CHANGEME
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
EMAIL_FROM=no-reply@CHANGEME

# Hetzner Object Storage — infra/terraform/modules/object_storage, output
# `endpoint`/`bucket_name`. Credenciales generadas a mano en la consola de
# Hetzner (independientes de HCLOUD_TOKEN, ver infra/terraform/README.md).
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=iot-platform-CHANGEME
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
CORS_ALLOWED_ORIGINS=https://app.CHANGEME

APP_BASE_URL=https://app.CHANGEME

# Solo tiene efecto en el primer arranque contra una base de datos vacía
# (crea al primer Admin de plataforma) — no lo dejes puesto indefinidamente
# con una contraseña real en un secreto de larga duración más de lo
# necesario.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=CHANGEME
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=CHANGEME

# --- Específicas de este despliegue (no existen en apps/backend/.env.example) ---

# Grafana Cloud (OBSERVABILITY.md §2) — instance-id:api-token codificado en
# base64 (`echo -n "<instance-id>:<api-token>" | base64`), nunca las dos
# partes por separado.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-CHANGEME.grafana.net/otlp
GRAFANA_CLOUD_OTLP_AUTH=CHANGEME

# Usados por docker-compose.deploy.yml y el Caddyfile, no por la app en sí.
IMAGE_TAG=CHANGEME_SHA_DEL_COMMIT
ENVIRONMENT_NAME=staging
DOMAIN=example.com
ENVIRONMENT_SUBDOMAIN=staging.
