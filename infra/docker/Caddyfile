# Reverse proxy + TLS automático (Let's Encrypt) para api/app (DEPLOYMENT.md
# sección 6) — el mismo Caddyfile sirve staging y producción: solo cambia
# {$ENVIRONMENT_SUBDOMAIN} ("" en producción, "staging-" en staging,
# inyectado por docker-compose.deploy.yml). Prefijo del MISMO nivel
# (staging-api.<dominio>), no un subdominio anidado (api.staging.<dominio>)
# — el certificado Universal SSL gratuito de Cloudflare solo cubre un nivel
# de subdominio, encontrado en vivo en el primer despliegue real
# (2026-08-04). mqtt.<dominio> NO pasa por aquí (TLS propio de EMQX, ver
# docker-compose.deploy.yml).

{$ENVIRONMENT_SUBDOMAIN}api.{$DOMAIN} {
	reverse_proxy api_1:3000 api_2:3000 {
		health_uri /health
		health_interval 10s
		health_timeout 5s
		lb_policy round_robin
	}
}

{$ENVIRONMENT_SUBDOMAIN}app.{$DOMAIN} {
	root * /srv/web
	encode gzip
	try_files {path} /index.html
	file_server

	# Ningún archivo del build de Flutter web tiene nombre con hash de
	# contenido (a diferencia de webpack/vite) — `main.dart.js`/`index.html`
	# se llaman igual en cada despliegue, con contenido distinto. La app ya
	# gestiona su propia caché/actualización vía `flutter_service_worker.js`
	# — Cloudflare cacheando por encima de eso (su comportamiento por
	# defecto según extensión) sirve una versión vieja durante horas tras
	# cada despliegue (bug real en vivo, 2026-08-04: main.dart.js con un bug
	# ya corregido en el origen seguía viéndose en el navegador 22 minutos
	# después, cf-cache-status: HIT). Se desactiva la caché de borde para
	# esta zona entera — es un panel de monitorización, no una tienda con
	# tráfico masivo que necesite ese ahorro.
	header Cache-Control "no-cache"
}
